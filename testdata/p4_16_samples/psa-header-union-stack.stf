# Each member of the header union.
# 00 = end -> 1 headers parsed (parsed count = 1), first member = 0, 1 option being 0
packet 0 00
expect 1 01 00 00 $

# 01 = nop -> 1 headers parsed (parsed count = 1), first member = 1, 1 option being 1
# Without a proper end (option 00), packet too short error should occur, so the original option
# should still be unparsed and is sent at the end of the packet at is
packet 0 01
expect 1 01 01 01 $

# 02 = ss -> 1 headers parsed (parsed count = 1), first member = 1, 1 option being 1
# Again, without a proper end (option 00), it should be the same as the previous
# option 01 test
packet 0 02 11223344
expect 1 01 02 02 11223344 $

packet 0 03 aabbcc
expect 1 01 03 03 aabbcc $

packet 0 05 06 deadbeef
expect 1 01 05 05 06 deadbeef $

# 01 = nop -> This time, with a proper end option. The options are parsed.
# 2 headers parsed (parsed count = 2), first member = 1, 2 options being parsed
# are 01 and 00
packet 0 01 00
expect 1 02 01 01 00 $

# Early end with 00 as the third option
# Several different union members in one stack.
packet 0 01 01 00 01020304 03 050607 05 06 11223344 00
expect 1 03 01 01 01 00 01020304 03 050607 05 06 11223344 00 $

# Several different union members in one stack.
packet 0 01 01 02 01020304 03 050607 05 06 11223344 00
expect 1 06 01 01 01 02 01020304 03 050607 05 06 11223344 00 $

# A full ten-element header-union stack.
packet 0 01 02 11223344 03 aabbcc 05 06 deadbeef 01 02 55667788 03 010203 05 06 12345678 03 ccbbaa 00
expect 1 0a 01 01 02 11223344 03 aabbcc 05 06 deadbeef 01 02 55667788 03 010203 05 06 12345678 03 ccbbaa 00 $
