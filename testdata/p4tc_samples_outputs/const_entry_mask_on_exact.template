#!/bin/bash -x

set -e

: "${TC:="tc"}"
$TC p4template create pipeline/const_entry_mask_on_exact numtables 1

$TC p4template create action/const_entry_mask_on_exact/MainControlImpl/a_with_control_params actid 1 \
	param x type bit16
$TC p4template update action/const_entry_mask_on_exact/MainControlImpl/a_with_control_params state active

$TC p4template create table/const_entry_mask_on_exact/MainControlImpl/t_exact \
	tblid 1 \
	type exact \
	keysz 16 permissions 0x3da4 tentries 1024 nummasks 1 \
	table_acts act name const_entry_mask_on_exact/MainControlImpl/a_with_control_params
$TC p4template update table/const_entry_mask_on_exact/MainControlImpl/t_exact default_miss_action action const_entry_mask_on_exact/MainControlImpl/a_with_control_params param x 0
$TC p4template create table/const_entry_mask_on_exact/MainControlImpl/t_exact entry h.h.e 0xb00 permissions 0x1024 action const_entry_mask_on_exact/MainControlImpl/a_with_control_params param x 1
$TC p4template update pipeline/const_entry_mask_on_exact state ready