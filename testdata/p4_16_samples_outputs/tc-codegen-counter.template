#!/bin/bash -x

set -e

: "${TC:="tc"}"
$TC p4template create pipeline/tc-codegen-counter numtables 0

$TC p4template create extern/root/Counter extid 0x19000000 numinstances 1 tc_acl 0x1136 has_exec_method

$TC p4template create extern_inst/tc-codegen-counter/Counter/Ingress.counters instid 1 \
tc_numel 8 \
constructor param type ptype bit32 0 \
control_path tc_key index ptype bit32 id 1 param pkts ptype bit64 id 2
$TC p4template update pipeline/tc-codegen-counter state ready