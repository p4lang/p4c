#!/bin/bash -x

set -e

: "${TC:="tc"}"
$TC p4template create pipeline/pna-register-init numtables 0

$TC p4template create extern/root/Register extid 0x1 numinstances 5 tc_acl 0x19b6

$TC p4template create extern_inst/pna-register-init/Register/Ingress.scalar instid 1 \
tc_numel 10 \
control_path tc_key index ptype bit32 id 1 param a_value ptype bit32 id 2 default_value 13

$TC p4template create extern_inst/pna-register-init/Register/Ingress.wide instid 2 \
tc_numel 3 \
control_path tc_key index ptype bit32 id 1 param a_value ptype bit64 id 2 default_value 18364758544493064720

$TC p4template create extern_inst/pna-register-init/Register/Ingress.pair instid 3 \
tc_numel 3 \
control_path tc_key index ptype bit32 id 1 param protocol ptype bit8 id 2 default_value 17 param aux ptype bit8 id 3 default_value 22

$TC p4template create extern_inst/pna-register-init/Register/Ingress.zero instid 4 \
tc_numel 2 \
control_path tc_key index ptype bit32 id 1 param a_value ptype bit32 id 2 default_value 0

$TC p4template create extern_inst/pna-register-init/Register/Ingress.unspecified instid 5 \
tc_numel 2 \
control_path tc_key index ptype bit32 id 1 param a_value ptype bit32 id 2
$TC p4template update pipeline/pna-register-init state ready