---
# Keep CI focused on correctness and ownership. Formatting belongs to clang-format;
# broad modernization/style families substantially increase repeated IR-header work.
# Analyzer checks must be explicit: LLVM 22 removed them from the default set.
Checks: >-
  -*,
  clang-diagnostic-*,
  clang-analyzer-core.*,
  clang-analyzer-cplusplus.*,
  clang-analyzer-unix.Malloc*,
  clang-analyzer-unix.MismatchedDeallocator,
  clang-analyzer-unix.cstring.*,
  cppcoreguidelines-owning-memory,
  bugprone-use-after-move,
  bugprone-dangling-handle,
  bugprone-unused-raii,
  bugprone-unchecked-optional-access,
  bugprone-incorrect-enable-shared-from-this,
  bugprone-return-const-ref-from-parameter,
  bugprone-suspicious-realloc-usage,
  bugprone-inaccurate-erase,
  bugprone-sizeof-expression,
  bugprone-sizeof-container,
  bugprone-stringview-nullptr,
  misc-uniqueptr-reset-release
FormatStyle: file
WarningsAsErrors: ''
HeaderFilterRegex: ''
UseColor: true
...
