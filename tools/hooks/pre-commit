"""Check staged C++ formatting. Semantic clang-tidy checks run in CI.

Use tools/run-clang-tidy.py --staged with a configured build for local analysis.
Keeping compilation-database-dependent analysis out of this hook lets developers
commit without a configured build and keeps the hook fast.
"""

import subprocess
import sys

result = subprocess.run(
    ["git", "clang-format", "--diff", "--staged"], capture_output=True, text=True
)
if result.returncode or "diff --git" in result.stdout:
    print(result.stdout, end="")
    print(result.stderr, end="", file=sys.stderr)
    print("Run git clang-format --staged to format the staged changes.", file=sys.stderr)
    sys.exit(1)
