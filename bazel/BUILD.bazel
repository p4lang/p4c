load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":cc_system_includes.bzl", "cc_system_includes")

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "cc_system_includes",
    srcs = ["cc_system_includes.bzl"],
    deps = ["@rules_cc//cc/common"],
)

# Add include-path metadata once; ordinary Abseil dependencies stay unchanged.
# //:lib propagates this to p4c and downstream users of its public headers.
cc_system_includes(
    name = "abseil_system_includes",
    dep = "@abseil-cpp//absl/base:config",
    visibility = ["//:__pkg__"],
)

bzl_library(
    name = "bison",
    srcs = ["bison.bzl"],
)

bzl_library(
    name = "flex",
    srcs = ["flex.bzl"],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
)

bzl_library(
    name = "repositories",
    srcs = ["repositories.bzl"],
)

bzl_library(
    name = "p4_library",
    srcs = ["p4_library.bzl"],
    deps = ["@rules_cc//cc:find_cc_toolchain.bzl"],
)
